{
  "name": "iwi-website-angular",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve website",
    "build": "ng build website",
    "build:api": "ng build api",
    "watch": "ng build website --watch --configuration development",
    "test": "ng test website --watch=false",
    "format": "prettier --write \"projects/website/src/**/*.{ts,html,scss}\"",
    "format:check": "prettier --check \"projects/website/src/**/*.{ts,html,scss}\"",
    "api:spec": "curl -fsS -o openapi/iwi-api.json http://localhost:5200/swagger/v1/swagger.json",
    "api:generate": "openapi-generator-cli generate --generator-key iwi-api",
    "api:update": "npm run api:spec && npm run api:generate",
    "serve:static": "npx --yes serve@14 dist/website/browser -l 4300"
  },
  "private": true,
  "packageManager": "npm@11.19.1",
  "dependencies": {
    "@angular/cdk": "^22.2.3",
    "@angular/common": "^22.2.0",
    "@angular/compiler": "^22.2.0",
    "@angular/core": "^22.2.0",
    "@angular/forms": "^22.2.0",
    "@angular/material": "^22.2.3",
    "@angular/platform-browser": "^22.2.0",
    "@angular/platform-server": "^22.2.0",
    "@angular/router": "^22.2.0",
    "@angular/ssr": "^22.2.3",
    "@mdi/js": "^7.4.47",
    "bootstrap": "^5.3.8",
    "rxjs": "~7.8.0",
    "simple-icons": "^16.35.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^22.2.3",
    "@angular/cli": "^22.2.3",
    "@angular/compiler-cli": "^22.2.0",
    "@openapitools/openapi-generator-cli": "^2.41.0",
    "@types/node": "^22.12.0",
    "jsdom": "^30.0.0",
    "ng-packagr": "^22.2.0",
    "prettier": "^3.8.1",
    "typescript": "~6.0.2",
    "vitest": "^5.0.0"
  },
  "description": "Website der Fachschaft IWI (Angular, statisch vorgerendert)"
}
