{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Media": {
    "BaseUrl": "https://cloud.iwi-hka.de/remote.php/dav/files/system_user/Fachschaft/Systems/Information System/",
    "ConfigFileName": "appconfig.Information System.json"
  },
  "Protocols": {
    "BaseUrl": "https://cloud.iwi-hka.de/remote.php/dav/files/system_user/Fachschaft/FB_Archiv/fs_sitzungsprotokolle/",
    "CacheDirectory": "/data/cache/protocolls"
  },
  "Sync": {
    "IntervalHours": 6,
    "CacheDirectory": "cache",
    "DefaultDurationSeconds": 30,
    "RefreshToken": ""
  },
  
  "Instagram": {
    "TokenFilePath": "instagram_token.txt",
    "CacheDirectory": "cache/instagram",
    "SyncIntervalMinutes": 30,
    "PostLimit": 12
  },

  "Cors": {
    "AllowedOrigins": [
      "http://localhost:3000",
      "https://www.new.iwi-hka.de"
    ]
  }
}
